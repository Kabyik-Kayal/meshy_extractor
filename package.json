{
  "name": "meshy-extractor",
  "version": "1.0.0",
  "description": "Web application and CLI to extract and decrypt raw 3D models (.glb) from Meshy AI shareable links",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "meshy-extractor": "./extract_meshy.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "cli": "node extract_meshy.mjs"
  },
  "keywords": [
    "meshy",
    "meshy-ai",
    "3d",
    "3d-models",
    "glb",
    "gltf",
    "extractor",
    "decrypter",
    "wasm",
    "webassembly"
  ],
  "author": "Kabyik Kayal",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}
